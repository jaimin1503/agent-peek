{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the overlay and history windows",
  "windows": ["main", "history"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:tray:default",
    "core:menu:default",
    "notification:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/.agentpeek" }, { "path": "$HOME/.agentpeek/**" }]
    }
  ]
}
